+// Build-only compatibility for a Qt without Vulkan support.
+// The Kinfocenter OpenGL path needs only these enum values.
+#pragma once
+
+using VkPhysicalDeviceType = int;
+inline constexpr VkPhysicalDeviceType VK_PHYSICAL_DEVICE_TYPE_OTHER = 0;
+inline constexpr VkPhysicalDeviceType VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU = 1;
+inline constexpr VkPhysicalDeviceType VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU = 2;
+inline constexpr VkPhysicalDeviceType VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU = 3;
+inline constexpr VkPhysicalDeviceType VK_PHYSICAL_DEVICE_TYPE_CPU = 4;
+inline constexpr VkPhysicalDeviceType VK_PHYSICAL_DEVICE_TYPE_MAX_ENUM = 0x7fffffff;
